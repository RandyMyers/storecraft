PORT=4000
# production | development — production disables permissive public host query defaults
# NODE_ENV=production

JWT_SECRET=change-me-to-a-long-random-string
# Primary app origin (marketing + dashboard). localhost:3000/3001 + citematch.com are always allowed via config defaults.
CLIENT_ORIGIN=https://citematch.com
# Optional extra origins (merged with built-in localhost:3000, localhost:3001, citematch.com, www)
# ADDITIONAL_CORS_ORIGINS=
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/DATABASE_NAME?appName=YourApp

# Cloudinary (optional — omit to disable uploads; editor will show manual URL fields)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# Optional: bypass real DNS TXT verification (marks domains verified instantly)
SKIP_DNS_VERIFY=false

# Public publish hostname routing — apex for {subdomain}.{PLATFORM_PUBLISH_DOMAIN}
PLATFORM_PUBLISH_DOMAIN=citematch.com
# Required when client is on Hostinger and API on Vercel (browser cannot send tenant Host to API):
TRUST_PUBLISH_HOSTNAME_QUERY=true
PUBLIC_HOST_QUERY=true
# Local dev (same machine): set both false if API and client share origin/proxy
# TRUST_PUBLISH_HOSTNAME_QUERY=false
# PUBLIC_HOST_QUERY=false
PUBLIC_BASE_URL=
PUBLIC_URL_PROTO=https

# Optional: base URL for template thumbnails (seed builds `{slug}.jpg` URLs). Leave unset for empty thumbnails (UI shows initials).
# PUBLIC_TEMPLATE_THUMB_BASE=https://cdn.example.com/template-thumbs

# If true, TXT verification sets ssl_status to ssl_pending (await real cert worker)
STRICT_SSL_LIFECYCLE=false

# DNS verification worker (Phase 4) — separate process or cron
# DNS_WORKER_ENABLED=true   # required for long-running loop (npm run worker:dns)
# DNS_WORKER_INTERVAL_MS=120000
# DNS_WORKER_BATCH=25
# DNS_WORKER_MIN_RETRY_MS=120000
# npm run worker:dns:once   # single batch (cron-friendly; no DNS_WORKER_ENABLED needed)

# SSL probe worker (Phase 5) — promotes ssl_pending → active when :443 TLS validates
# SSL_WORKER_ENABLED=true
# SSL_WORKER_INTERVAL_MS=180000
# SSL_WORKER_BATCH=15
# SSL_PROBE_TIMEOUT_MS=12000
# npm run worker:ssl:once

# Cap stored publish snapshots per site (Phase 7)
# PUBLISH_HISTORY_MAX=50

# Trust X-Forwarded-For (Phase 8 — rate limits / Turnstile remoteip). Production default is 1 hop.
# TRUST_PROXY=false
# TRUST_PROXY=2

# Public form rate limit — sliding window per client IP + site subdomain (Phase 8)
# FORM_RATE_LIMIT_WINDOW_MS=60000
# FORM_RATE_LIMIT_MAX=12

# Cloudflare Turnstile — when set, POST .../form requires a valid token (pair with client site key)
# TURNSTILE_SECRET_KEY=

# Sentry (Phase 10) — omit DSN to disable server-side error reporting
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0

# Billing + ops — manual bank / USDT (Nestpage full product plan §Phase B).
# Admin `/api/admin/*`: prefer operator JWT from POST /api/admin/auth/login (email + password, see AdminAccount).
# Optional legacy shared key for POST /api/admin/auth/token + header X-Nestpage-Admin-Key (automation / break-glass):
# ADMIN_API_KEY=long-random-secret
# Integration secrets (Vercel, Cloudinary, Hostinger, etc.) — GET/POST /api/admin/secrets …
# SECRETS_MASTER_KEY=any-long-random-string   # hashed with SHA-256 to derive AES key
# Hostinger: admin Integrations → provider `hostinger` (API token from hPanel). Creates {sub}.PLATFORM_PUBLISH_DOMAIN
# via POST /api/hosting/v1/websites when provisioned; DNS TXT for custom domains; optional wildcard A on VPS.
# HOSTINGER_HOSTING_ORDER_ID=12345
# HOSTINGER_AUTO_PROVISION_SUBDOMAIN=true
# Publish + signup call Hostinger create-website when Integrations token is set (same public_html in hPanel).
# SECRETS_KEY_VERSION=v1
# Admin dashboard: GET /api/admin/overview/stats (aggregate counts; requires operator JWT).
# Admin operators (Mongo `AdminAccount`) — create first user from `server/`: npm run create:admin
# ADMIN_OPERATOR_EMAIL=admin@yourcompany.com
# ADMIN_OPERATOR_PASSWORD=choose-a-long-password
#
# Local dashboard (non-production only): on API boot, if AdminAccount collection is empty, one operator is auto-created using:
# SEED_ADMIN_EMAIL=admin@nestpage.local
# SEED_ADMIN_PASSWORD=NestpageDev1!
# Set DISABLE_AUTO_ADMIN=true to skip (e.g. shared dev DB); then use npm run create:admin
# Admin session JWT (optional; defaults JWT_SECRET) — POST /api/admin/auth/token | /refresh
# ADMIN_JWT_SECRET=
# ADMIN_JWT_EXPIRES_SECONDS=900
# Optional Slack-compatible webhook for integration-secret create/rotate/enable/disable (no secret values sent)
# ADMIN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…
# PAYMENT_INSTRUCTIONS_BANK=IBAN … beneficiary … reference format …
# PAYMENT_INSTRUCTIONS_USDT=Network (e.g. TRC20), wallet address, memo rules …

# Subscription tiers — stored in Mongo (`Plan` model); defaults seeded on connect from `config/plans.js`.
# Public: GET /api/plans , GET /api/plans/:slug ; GET /api/templates (site starters)
# Admin: GET /api/admin/plans , PATCH /api/admin/plans/:slug  (Authorization: Bearer operator JWT)
